{
  "expo": {
    "name": "Tably",
    "slug": "tably",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.tably.app",
      "versionCode": 4,
      "allowBackup": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F2"
      }
    },
    "ios": {
      "bundleIdentifier": "com.tably.app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F5"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4fc86cd2-7d14-453d-b7c5-c0da4c7839e4"
      }
    },
    "icon": "./assets/icon.png",
    "scheme": "tably",
    "backgroundColor": "#FAF7F2",
    "splash": {
      "image": "./assets/splash-blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F5"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "skanda_v"
  }
}
